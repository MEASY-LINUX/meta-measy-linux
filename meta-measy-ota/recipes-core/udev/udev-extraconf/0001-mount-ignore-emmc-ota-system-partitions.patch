From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MYIR <support@myirtech.com>
Date: Fri, 13 Nov 2026 16:30:00 +0800
Subject: [PATCH] mount: ignore eMMC OTA system partitions

SWUpdate writes the inactive rootfs partition as a raw image and mounts the
inactive boot partition itself.  udev-extraconf must not auto-mount the target
slot behind SWUpdate's back.  Keep automounting enabled for external media so
a large SWU can still be supplied on USB storage.

The MYD-JMX95 eMMC is mmcblk0 and its OTA system partitions are p1 through p4;
p5 is the persistent overlay partition.  Unlike a conventional rootfs, a
dm-verity root is exposed as /dev/mapper/rootfs, so mount.sh cannot detect its
backing p2/p4 by comparing the root device number.  Never automount either
rootfs partition.  Selectively ignore the inactive boot partition using the
same bootslot policy as the reference BSP.

Upstream-Status: Inappropriate [MYIR product partition layout]

---
 mount.sh | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/mount.sh b/mount.sh
index 2a6ff97..66442da 100644
--- a/mount.sh
+++ b/mount.sh
@@ -37,6 +37,44 @@ do
 	fi
 done
 
+should_ignore_ota_partition() {
+    dev="$1"
+
+    if [ ! -e /etc/myir-ota-enabled ]; then
+        return 1
+    fi
+
+    case "$dev" in
+        /dev/mmcblk0p2|/dev/mmcblk0p4)
+            return 0
+            ;;
+        /dev/mmcblk0p1|/dev/mmcblk0p3)
+            ;;
+        *)
+            return 1
+            ;;
+    esac
+
+    bootslot=""
+    if command -v fw_printenv >/dev/null 2>&1; then
+        bootslot="$(fw_printenv bootslot 2>/dev/null | sed -n 's/^bootslot=//p')"
+    fi
+
+    case "$bootslot:$dev" in
+        dualA:/dev/mmcblk0p3|dualB:/dev/mmcblk0p1)
+            return 0
+            ;;
+        dualA:*|dualB:*)
+            return 1
+            ;;
+        *)
+            logger "udev/mount.sh" \
+                "cannot determine bootslot; conservatively ignoring $dev"
+            return 0
+            ;;
+    esac
+}
+
 is_filesystem_supported() {
     while read -r fs; do
        if [ "${fs#nodev}" = "$1" ];
@@ -194,6 +232,12 @@ name="`basename "$DEVNAME"`"
 [ -e /sys/block/$name/device/media ] && media_type=`cat /sys/block/$name/device/media`
 
 if [ "$ACTION" = "add" ] && [ -n "$DEVNAME" ] && [ -n "$ID_FS_TYPE" -o "$media_type" = "cdrom" ]; then
+    if should_ignore_ota_partition "$DEVNAME"; then
+        logger "udev/mount.sh" \
+            "[$DEVNAME] is an OTA system partition; skipping automount"
+        exit 0
+    fi
+
     # Note the root filesystem can show up as /dev/root in /proc/mounts,
     # so check the device number too
     if expr $MAJOR "*" 256 + $MINOR != `stat -c %d /`; then
-- 
