From c0605970c1c0976fe52bee41751a35c3809b1b88 Mon Sep 17 00:00:00 2001
From: Jiafei Pan <Jiafei.Pan@nxp.com>
Date: Tue, 19 May 2026 15:34:59 +0800
Subject: [PATCH 2/2] kernel: expose PREEMPT_RT status in sysfs

Expose /sys/kernel/realtime when PREEMPT_RT is enabled. This is the
architecture-independent status interface carried by NXP Real-Time Edge
as part of its 6.18.13-rt4 integration. The unrelated ARM, PowerPC and
i915 portions of that older RT patch are intentionally not backported.

Upstream-Status: Backport [NXP real-time-edge-linux c0605970c1c0]
Signed-off-by: Jiafei Pan <Jiafei.Pan@nxp.com>
---
 kernel/ksysfs.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/kernel/ksysfs.c b/kernel/ksysfs.c
index eefb67d9883c..20ac8a5ac27d7 100644
--- a/kernel/ksysfs.c
+++ b/kernel/ksysfs.c
@@ -188,6 +188,15 @@ KERNEL_ATTR_RO(crash_elfcorehdr_size);
 
 #endif /* CONFIG_VMCORE_INFO */
 
+#if defined(CONFIG_PREEMPT_RT)
+static ssize_t realtime_show(struct kobject *kobj,
+			     struct kobj_attribute *attr, char *buf)
+{
+	return sprintf(buf, "1\n");
+}
+KERNEL_ATTR_RO(realtime);
+#endif
+
 /* whether file capabilities are enabled */
 static ssize_t fscaps_show(struct kobject *kobj,
 				  struct kobj_attribute *attr, char *buf)
@@ -271,6 +280,9 @@ static struct attribute * kernel_attrs[] = {
 #ifndef CONFIG_TINY_RCU
 	&rcu_expedited_attr.attr,
 	&rcu_normal_attr.attr,
+#endif
+#ifdef CONFIG_PREEMPT_RT
+	&realtime_attr.attr,
 #endif
 	NULL
 };
